# Copiar este archivo a .env (no se versiona) y ajustar el valor.
# Expo inyecta las variables EXPO_PUBLIC_* en el bundle al empaquetar:
# después de cambiarla, reiniciar el servidor con `npx expo start -c`.
#
# Emulador Android (es también el valor por defecto si la variable no está definida):
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#
# Dispositivo físico: IPv4 de la PC en la misma red Wi-Fi, con el puerto 3000 accesible.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
#
# Fuera del desarrollo local (pruebas remotas, producción): usar HTTPS.
# EXPO_PUBLIC_API_URL=https://api.ejemplo.com
